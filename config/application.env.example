# Runtime
PTAGENT_ENV=local
PTAGENT_DEMO_AUTH=true
PTAGENT_ALLOWED_ORIGIN=
PTAGENT_MAX_REQUEST_BYTES=1048576
PTAGENT_DATA_DIR=./data
PORT=8080

# Pending external authentication services. Do not commit real values.
WECHAT_APP_ID=
WECHAT_APP_SECRET=
QQ_APP_ID=
QQ_APP_KEY=
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=

# Pending infrastructure services.
MYSQL_URL=
MYSQL_USERNAME=
MYSQL_PASSWORD=
REDIS_URL=
OSS_ENDPOINT=
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
AMAP_WEB_KEY=
AMAP_SECURITY_CODE=
